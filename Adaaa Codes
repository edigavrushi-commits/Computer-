import time
import matplotlib.pyplot as plt

def linear_search(arr, key):
    for i in range(len(arr)):
        if arr[i] == key:
            return i
    return -1

n = [1000, 2000, 3000, 4000]
t = []

for size in n:
    arr = list(range(size))
    key = size - 1

    start = time.time()
    linear_search(arr, key)
    end = time.time()

    t.append(end - start)

plt.plot(n, t)
plt.xlabel("Array Size")
plt.ylabel("Time")
plt.title("Linear Search Time Complexity")
plt.show()






import time
import matplotlib.pyplot as plt

def binary_search(a, x):
    l, h = 0, len(a)-1
    while l <= h:
        m = (l+h)//2
        if a[m] == x:
            return m
        elif a[m] < x:
            l = m + 1
        else:
            h = m - 1

n = [2000, 5000, 10000]
t = []

for i in n:
    a = list(range(i))
    s = time.time()
    binary_search(a, i//2)
    t.append(time.time() - s)

plt.plot(n, t)
plt.xlabel("Array Size")
plt.ylabel("Time")
plt.title("Binary Search Time Complexity")
plt.show()






