from from collections import deque

q = deque([(0, 0)])
visited = {(0, 0)}

while q:
    a, b = q.popleft()
    print((a, b))

    if a == 2:
        print("Goal State Reached")
        break

    states = [
        (4, b), (a, 3), (0, b), (a, 0),
        (a - min(a, 3 - b), b + min(a, 3 - b)),
        (a + min(b, 4 - a), b - min(b, 4 - a))
    ]

    for s in states:
        if s not in visited:
            visited.add(s)
            q.append(s)





import random

def hill(arr):
    c = random.randint(0, len(arr)-1)

    while True:
        if c > 0 and arr[c-1] > arr[c]:
            c -= 1
        elif c < len(arr)-1 and arr[c+1] > arr[c]:
            c += 1
        else:
            break

    return c, arr[c]

data = [10, 20, 5, 23, 90, 67]

i, v = hill(data)

print("Peak Index:", i)
print("Peak Value:", v)



