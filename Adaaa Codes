for u, v, w in edges:
    x = find(p, u)
    y = find(p, v)
    if x != y:
        print(u, "-", v, "=", w)
        p[x] = y







def subset(a, t, s=[]):
    if t == 0:
        return [s]
    if not a or t < 0:
        return []
    return subset(a[1:], t-a[0], s+[a[0]]) + subset(a[1:], t, s)

